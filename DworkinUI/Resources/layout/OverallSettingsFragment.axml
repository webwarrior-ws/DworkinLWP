<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView 
		android:orientation="vertical"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<LinearLayout
			android:id="@+id/controls_group"
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingHorizontal="?android:attr/scrollbarSize">
			
			<!-- Preset control same as in AppearanceSettingsFragment.axml -->
			<LinearLayout
				android:id="@+id/preset_control"
				android:orientation="vertical"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingHorizontal="@dimen/editor_padding_h"
				android:paddingVertical="@dimen/editor_padding_v">
				<LinearLayout
					android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
					<TextView 
						android:text="Preset:"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingRight="20sp"
						android:paddingBottom="@dimen/editor_title_padding_bottom"
						android:textAppearance="@style/SettingsGroupTitle" />
					<TextView
						android:id="@+id/preset_name_display"
						android:text="Custom"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_gravity="right"
						android:layout_weight="1"
						android:textAppearance="@style/SettingTitle"/>
				</LinearLayout>
				<TextView
					android:text="Click to open preset manager"
					android:layout_width="match_parent"
					android:layout_height="wrap_content" />
			</LinearLayout>

			<LinearLayout
				android:id="@+id/pattern_link"
				android:orientation="vertical"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingHorizontal="@dimen/editor_padding_h"
				android:paddingVertical="@dimen/editor_padding_v">
				<TextView 
					android:text="Pattern"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingBottom="@dimen/editor_title_padding_bottom"
					android:textAppearance="@style/SettingsGroupTitle" />
				<TextView
					android:text="Click to change pattern settings"
					android:layout_width="match_parent"
					android:layout_height="wrap_content" />
			</LinearLayout>

			<LinearLayout
				android:id="@+id/appearance_link"
				android:orientation="vertical"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingHorizontal="@dimen/editor_padding_h"
				android:paddingVertical="@dimen/editor_padding_v">
				<TextView 
					android:text="Appearance"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingBottom="@dimen/editor_title_padding_bottom"
					android:textAppearance="@style/SettingsGroupTitle" />
				<TextView
					android:text="Click to change colors, materials, and effect"
					android:layout_width="match_parent"
					android:layout_height="wrap_content" />
			</LinearLayout>
			
			<LinearLayout
				android:orientation="vertical"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingVertical="@dimen/editor_padding_v"
				android:paddingHorizontal="@dimen/editor_padding_h">
				<TextView
					android:text="Speed"
					android:textAppearance="@style/SettingTitle"
					android:padding="6dp"
					android:layout_width="wrap_content"
					android:layout_height="match_parent"
					android:gravity="center_vertical"/>
				<SeekBar
					android:id="@+id/speed_display"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:layout_marginHorizontal="12dp"
					android:inputType="number"
					android:layout_marginVertical="6dp" />
			</LinearLayout>

			<LinearLayout
				android:orientation="vertical"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingHorizontal="@dimen/editor_padding_h"
				android:paddingVertical="@dimen/editor_padding_v">
				
				<TextView 
					android:text="Randomization"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingBottom="@dimen/editor_title_padding_bottom"
					android:textAppearance="@style/SettingsGroupTitle" />
				
				<LinearLayout
					android:orientation="horizontal"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingHorizontal="@dimen/editor_padding_h"
					android:paddingVertical="@dimen/editor_padding_v"
					android:focusableInTouchMode="true"
					android:focusable="true">
					<TextView
						android:text="Seed"
						android:textAppearance="@style/SettingTitle"
						android:paddingRight="6dp"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:gravity="center_vertical"/>
					<EditText
						android:id="@+id/seed_display"
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:layout_marginHorizontal="6dp"
						android:layout_weight="1"
						android:inputType="number"
						android:text="0"/>
					<Button
						android:id="@+id/next_seed_button"
						android:text="Next"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="6dp"
						android:layout_weight="1"/>
				</LinearLayout>

				<LinearLayout
					android:id="@+id/interval_control"
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingVertical="@dimen/editor_padding_v"
					android:paddingHorizontal="@dimen/editor_padding_h">
					<TextView
						android:text="Interval"
						android:textAppearance="@style/SettingTitle"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:gravity="center_vertical"/>
					<TextView
						android:id="@+id/interval_text"
						android:paddingVertical="@dimen/editor_padding_v"
						android:text="How often new pattern is drawn"
						android:layout_width="match_parent"
						android:layout_height="wrap_content" />
				</LinearLayout>
				
				<LinearLayout
					android:id="@+id/transition_control"
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:paddingVertical="@dimen/editor_padding_v"
					android:paddingHorizontal="@dimen/editor_padding_h">
					<TextView
						android:text="Transition"
						android:textAppearance="@style/SettingTitle"
						android:layout_width="wrap_content"
						android:layout_height="match_parent"
						android:gravity="center_vertical"/>
					<TextView
						android:id="@+id/transition_text"
						android:paddingVertical="@dimen/editor_padding_v"
						android:text="None"
						android:layout_width="match_parent"
						android:layout_height="wrap_content" />
				</LinearLayout>

			</LinearLayout>

		</LinearLayout>
	</ScrollView>
</FrameLayout>
