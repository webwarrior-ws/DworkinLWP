<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView 
		android:orientation="vertical"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<LinearLayout
			android:id="@+id/editors_group"
			android:orientation="vertical"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:paddingHorizontal="?android:attr/scrollbarSize">
			<LinearLayout
				android:id="@+id/preset_control"
				android:orientation="vertical"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingHorizontal="@dimen/editor_padding_h"
				android:paddingVertical="@dimen/editor_padding_v">
				<LinearLayout
					android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
					<TextView 
						android:text="Preset:"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:paddingRight="20sp"
						android:paddingBottom="@dimen/editor_title_padding_bottom"
						android:textAppearance="@style/SettingsGroupTitle" />
					<TextView
						android:id="@+id/preset_name_display"
						android:text="Custom"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_gravity="right"
						android:layout_weight="1"
						android:textAppearance="@style/SettingTitle"/>
				</LinearLayout>
				<TextView
					android:text="Open appearance preset manager"
					android:layout_width="match_parent"
					android:layout_height="wrap_content" />
			</LinearLayout>
		</LinearLayout>
	</ScrollView>
</FrameLayout>