<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:paddingHorizontal="@dimen/editor_padding_h"
    android:paddingVertical="@dimen/editor_padding_v">
	<TextView 
		android:text="Title"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingBottom="@dimen/editor_title_padding_bottom"
		android:textAppearance="@style/SettingTitle"
		android:id="@+id/title">
	</TextView>
	<LinearLayout
		android:orientation="horizontal"
		android:layout_width="match_parent"
		android:layout_height="wrap_content">
		<Spinner
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginHorizontal="16dp"
			android:id="@+id/spinner1" >
		</Spinner>
		<Settings.ToggleImageButton
			android:layout_width="@dimen/dice_button_size"
			android:layout_height="@dimen/dice_button_size"
			android:layout_gravity="center"
			android:src="@drawable/dice"
			android:scaleType="fitCenter"
			android:background="#ffffff"
			android:id="@+id/dice" />
	</LinearLayout>
</LinearLayout>
