<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#606060">
    <ImageView
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleY="-1" />
    <ImageView
        android:id="@+id/premium_indicator"
        android:layout_width="22sp"
        android:layout_height="34sp"
        android:paddingHorizontal="2sp"
        android:layout_gravity="top|left"
        android:src="@drawable/dollar_sign"
        android:visibility="invisible" />
    <ImageView
        android:id="@+id/random_indicator"
        android:layout_width="34sp"
        android:layout_height="34sp"
        android:padding="2dp"
        android:layout_gravity="top|right"
        android:src="@drawable/dice_preview"
        android:visibility="invisible" />
    <TextView
        android:id="@+id/nameDisplay"
        android:text="Preset Name"
        android:layout_width="wrap_content"
        android:layout_height="28sp"
        android:layout_gravity="center_horizontal|bottom"
        android:textColor="@android:color/white"
        android:shadowColor="#000000"
        android:shadowRadius="3.0"
        android:textSize="18sp"
        android:textAlignment="center">
    </TextView>
    <TextView
        android:id="@+id/statusDisplay"
        android:text="Loading preview..."
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@android:color/white"
        android:textAllCaps="true"
        android:textSize="20sp"
        android:textAlignment="center">
    </TextView>
</FrameLayout>
