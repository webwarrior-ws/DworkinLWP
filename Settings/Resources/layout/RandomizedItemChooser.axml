<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:orientation="vertical"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/editor_padding_h"
    android:paddingVertical="@dimen/editor_padding_v">
    <TextView
        android:text="Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:paddingBottom="@dimen/editor_title_padding_bottom"
        android:textAppearance="@style/SettingTitle"
        android:id="@+id/title" >
    </TextView>
    <LinearLayout
	    android:orientation="horizontal"
	    android:layout_width="match_parent"
	    android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:id="@+id/imageView"
                android:contentDescription=""
                android:layout_marginRight="8dp"/>
            <TextView
                android:text="selected item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textColor="@android:color/white"
                android:id="@+id/item_name" >
            </TextView>
        </LinearLayout>
	    <Settings.ToggleImageButton
		    android:layout_width="@dimen/dice_button_size"
		    android:layout_height="@dimen/dice_button_size"
		    android:src="@drawable/dice"
		    android:scaleType="fitCenter"
		    android:background="#ffffff"
		    android:id="@+id/dice" />
    </LinearLayout>
</LinearLayout>
