<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:orientation="horizontal"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:paddingHorizontal="@dimen/editor_padding_h"
    android:paddingVertical="@dimen/editor_padding_v">
	<TextView 
		android:text="Title"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:layout_gravity="center_vertical"
		android:textAppearance="@style/SettingTitle"
		android:id="@+id/title">
	</TextView>
	<Button
		android:layout_width="36dp"
		android:layout_height="36dp"
		android:layout_gravity="center_vertical"
		android:layout_marginRight="15dp"
		android:layout_marginLeft="15dp"
		android:id="@+id/swatch" >
	</Button>
	<Settings.ToggleImageButton
		android:layout_width="@dimen/dice_button_size"
		android:layout_height="@dimen/dice_button_size"
		android:src="@drawable/dice"
		android:scaleType="fitCenter"
		android:background="#ffffff"
		android:id="@+id/dice" />
</LinearLayout>