<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net461</TargetFramework>
    <RootNamespace>DworkinTestingApp_PC</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
	<Content Include="DefaultSkin.png">
	  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</Content>
	<Compile Include="../DworkinTestingApp/GeneratedConfigs.fs" />
	<Compile Include="GUI.fs" />
	<Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup />

  <ItemGroup>
    <PackageReference Include="Gwen.Renderer.OpenTK" Version="3.0.6001.430" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LibDworkin-PC\LibDworkin-PC.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="4.5.4" />
  </ItemGroup>

</Project>
